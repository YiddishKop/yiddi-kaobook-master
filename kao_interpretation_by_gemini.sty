% 检查编译器是否是 XeTeX 或 LuaTeX
\newif\ifxetexorluatex % 定义条件开关
\ifxetex % 如果是 XeTeX
	\xetexorluatextrue % 开关为 true
\else % 否则
	\ifluatex % 如果是 LuaTeX
		\xetexorluatextrue % 开关为 true
	\else % 否则
		\xetexorluatexfalse % 开关为 false (即是 pdfTeX)
	\fi
\fi

