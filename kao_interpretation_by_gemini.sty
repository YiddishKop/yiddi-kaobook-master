% 定义用于设置文档比例的长度。这些长度影响页面几何、段落间距等
\newlength{\hscale}
\newlength{\vscale}

% 默认情况下，比例尺设置为 A4 纸张
\setlength{\hscale}{1mm}
\setlength{\vscale}{1mm}

% 根据文档类选项设置 hscale 和 vscale (根据不同的纸张大小设置不同的缩放比例)
% 此处代码重复检查各种纸张类型（A0-A6, B0-B6, C0-C6, ANSI, Letter 等），并设置相应的 \hscale 和 \vscale
% 这是一个庞大的条件块，用于计算不同纸张尺寸下的缩放比例
\@ifclasswith{\@baseclass}{a0paper}{\setlength{\hscale}{4mm}\setlength{\vscale}{4mm}}{}
% ... (此处省略了大量的纸张尺寸条件，逻辑一致)
% ...

% 设置默认页面布局
\RequirePackage[
	paperwidth=210\hscale, % 纸张宽度为 210 * hscale
	paperheight=297\vscale, % 纸张高度为 297 * vscale
]{geometry} % 加载 geometry 宏包设置页面尺寸

% 定义命令 \pagelayout，用于选择三种页面布局之一
\DeclareDocumentCommand{\pagelayout}{m}{%
	\ifthenelse{\equal{margin}{#1}}{\marginlayout\marginfloatsetup}{}% % 如果是 'margin' 布局
	\ifthenelse{\equal{wide}{#1}}{\widelayout\widefloatsetup}{}% % 如果是 'wide' 布局
	\ifthenelse{\equal{fullwidth}{#1}}{\fullwidthlayout\widefloatsetup}{}% % 如果是 'fullwidth' 布局
}

\newif\ifwidelayout% % 定义条件开关，用于判断是否处于 'wide' 或 'fullwidth' 布局
\def\IfWideLayout{% % 定义一个条件命令，用于检查 \ifwidelayout 状态
	\ifwidelayout%
		\expandafter\@firstoftwo%
	\else%
		\expandafter\@secondoftwo%
	\fi%
}

% 布局 #1: 大边距（内容在左，边注在右/外侧）
\newcommand{\marginlayout}{%
	\newgeometry{
		top=27.4\vscale,
		bottom=27.4\vscale,
		inner=24.8\hscale, % 内侧边距
		textwidth=107\hscale, % 主文本宽度
		marginparsep=6.2\hscale, % 边注与主文本的间隔
		marginparwidth=47.7\hscale, % 边注宽度
	}%
	\recalchead% % 重新计算页眉相关的长度
	\widelayoutfalse% % 设置非宽布局
}

% 布局 #2: 小且对称的边距（没有边注区）
\newcommand{\widelayout}{%
	\newgeometry{
		top=27.4\vscale,
		bottom=27.4\vscale,
		inner=24.8\hscale,
		outer=24.8\hscale,
		marginparsep=0mm, % 边注间隔为 0
		marginparwidth=0mm, % 边注宽度为 0
	}%
	\recalchead%
	\widelayouttrue% % 设置为宽布局
}

% 布局 #3: 无边距和无页边距的“全宽页”
\newcommand{\fullwidthpage}{%
	\newgeometry{
		top=0mm,
		bottom=0mm,
		inner=0mm,
		outer=0mm,
		marginparwidth=0mm,
		marginparsep=0mm,
	}%
	\recalchead%
	\widelayouttrue%
}

% 设置默认页面布局为 'margin' 布局
\AtBeginDocument{\pagelayout{margin}}

