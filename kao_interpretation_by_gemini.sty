% 对边注进行两端对齐和格式化
\renewcommand*{\raggedleftmarginnote}{} % Suppress left margin
\renewcommand*{\raggedrightmarginnote}{} % Suppress right margin
\renewcommand*{\marginfont}{\@margin@par} % Format marginnotes according to \@marginpar (使用边注的段落格式)
\renewcommand{\marginnotevadjust}{0.8\vscale} % Bring all marginnotes downwards a bit % 边注向下微调
%\marginposadjustment=1\vscale % Bring downwards also the marginpars
%\marginheightadjustment=10cm % Adjust the height of the margins for each page
%\RequirePackage[marginnote=true]{snotez} % Provides options for sidenotes

% 从 snotez 复制的命令，用于检测偏移量是否以 \baselineskip 为单位
\def\kao@if@nblskip#1{%
	\expandafter\ifx\@car#1\@nil*%
		\expandafter\@firstoftwo%
	\else%
		\expandafter\@secondoftwo%
	\fi%
}

% 命令，用于检测是否在浮动环境中 (\tcolorbox 或 \minipage)
\newif\ifinfloat % First, set this flag whenever we are in a tcolorbox environment...
\AtBeginEnvironment{tcolorbox}{\infloattrue\renewcommand{\marginnotevadjust}{-1.4\vscale}} % 在 tcolorbox 开始时设置 flag
\AtBeginEnvironment{minipage}{\infloattrue} % 在 minipage 开始时设置 flag

\def\IfInFloatingEnvir{% ...Then, detect the flag
	\ifinfloat%
		\expandafter\@firstoftwo%
	\else%
		\expandafter\@secondoftwo%
	\fi%
}

% 重新定义 \marginnote 命令：
% (a) 可选偏移量参数放在第一位
% (b) 偏移量可以接受 baselineskip 的倍数
% Usage: \marginnote[<offset>]{Text of the note.}
\let\oldmarginnote\marginnote%
\RenewDocumentCommand\marginnote{ o m }{%
	\IfNoValueOrEmptyTF{#1}{%
		\IfInFloatingEnvir{% % 如果在浮动环境中，使用 \oldmarginnote
			\oldmarginnote{#2}%
		}{% % 如果不在浮动环境中，使用 \marginpar
			\marginpar{\@margin@par#2}%
		}%
	}{% % 如果有偏移量
		\oldmarginnote{#2}[\kao@if@nblskip{#1}{\@cdr#1\@nil\baselineskip}{#1}]%
	}%
}

% 重新定义 \sidenote 命令：
% (a) 侧边注计数器从 0 开始
% (b) 在打印侧边注前增加计数器
\setcounter{sidenote}{0}%
\RenewDocumentCommand\sidenote{ o o +m }{% number, offset, text
	\IfNoValueOrEmptyTF{#1}{%
		\refstepcounter{sidenote}% This command has been moved here % 增加计数器
	}{%
	}%
	\sidenotemark[#1]%
	\sidenotetext[#1][#2]{#3}%
	\@sidenotes@multimarker%
}

% 格式化侧边注标记
\RenewDocumentCommand\@sidenotes@thesidenotemark{ m }{% Format the marker
	\leavevmode%
	\ifhmode%
		\edef\@x@sf{\the\spacefactor}%
		\nobreak%
	\fi%
	\hbox{\@textsuperscript{\normalfont#1}}% % 以正常字体的小上标显示
	\ifhmode%
		\spacefactor\@x@sf%
	\fi%
	\relax%
}%

% 格式化侧边注文本
\RenewDocumentCommand\sidenotetext{ o o +m }{% number, offset, text
	\IfNoValueOrEmptyTF{#1}{%
		\marginnote[#2]{\thesidenote:\enskip#3}% % 使用 \marginnote 打印：计数器 + 文本
	}{%
