% 重新定义 \title 命令，增加一个可选参数用于纯文本标题
\newcommand{\@plaintitle}{} % 用于存储纯文本标题
\renewcommand{\title}[2][]{% % 重新定义 \title[可选纯文本]{实际标题}
	\gdef\@title{#2} % Store the full title in @title % 存储完整标题
	\ifthenelse{\isempty{#1}}{ % If there is no plain title % 如果没有提供纯文本标题
		\renewcommand{\@plaintitle}{\@title} % Use full title % 使用完整标题作为纯文本标题
	}{ % If there is a plain title % 如果提供了纯文本标题
		\renewcommand{\@plaintitle}{#1} % Use provided plain-text title % 使用提供的纯文本标题
	}%
	\hypersetup{pdftitle={\@plaintitle}} % Set the PDF metadata title % 设置 PDF 元数据中的标题
}

% 重新定义 \author 命令，增加一个可选参数用于纯文本作者名
\newcommand{\@plainauthor}{} % 用于存储纯文本作者
\renewcommand{\author}[2][]{% % 重新定义 \author[可选纯文本]{实际作者}
	\gdef\@author{#2} % Store the full author in @author % 存储完整作者名
	\ifthenelse{\isempty{#1}}{ % If there is no plain author % 如果没有提供纯文本作者名
		\renewcommand{\@plainauthor}{\@author}% Use full author % 使用完整作者名作为纯文本作者名
	}{ % If there is a plain author % 如果提供了纯文本作者名
		\renewcommand{\@plainauthor}{#1}% Use provided plain-text author % 使用提供的纯文本作者名
	}%
	\hypersetup{pdfauthor={\@plainauthor}} % Set the PDF metadata author % 设置 PDF 元数据中的作者
}

% 为标题页创建 PDF 书签
\pretocmd{\maketitle}{\pdfbookmark[1]{\@plaintitle}{title}}{}{}% % 在 \maketitle 之前插入 \pdfbookmark 命令

