\RequirePackage{scrlayer-scrpage}		% Customise head and foot regions % KOMA-Script 的页眉页脚宏包

% 设置页眉高度以防止警告
%\setlength{\headheight}{27.4\vscale}
% 增加页眉与文本之间的间距
\setlength{\headsep}{11\vscale}

% 定义页眉中使用的 LaTeX 长度
\newlength{\headtextwidth} % 页眉中的文本宽度 (等于 \textwidth)
\newlength{\headmarginparsep} % 页眉中的边注间隔 (等于 \marginparsep)
\newlength{\headmarginparwidth} % 页眉中的边注宽度 (等于 \marginparwidth)
\newlength{\headtotal} % 页眉的总宽度
\newlength{\contentwidth} % \headtotal 的别名
% 重新计算页眉相关长度的命令
\newcommand{\recalchead}{% Command to recalculate the header-related length when needed
	\setlength{\headtextwidth}{\textwidth}%
	\setlength{\headmarginparsep}{\marginparsep}%
	\setlength{\headmarginparwidth}{\marginparwidth}%
	\setlength{\headtotal}{\headtextwidth+\headmarginparsep+\headmarginparwidth}%
	\setlength{\contentwidth}{\headtotal}%
}

\AtBeginDocument{% Recalculate the header-related lengths % 在文档开始时计算
	\recalchead%
}

% 重新定义 scrheadings 样式（用于整个文档）
% 复杂的页眉定义，在左右两侧都有页码、分隔线、章/节标题
\renewpagestyle{scrheadings}{%
	% 偶数页 (左侧页眉)
	{\smash{\hspace{-\headmarginparwidth}\hspace{-\headmarginparsep}\makebox[\headtotal][l]{%
		\makebox[7\hscale][r]{\thepage}% % 左侧页码 (右对齐)
		\makebox[3\hscale]{}\rule[-1mm]{0.5pt}{19\vscale-1mm}\makebox[3\hscale]{}% % 垂直分隔线
		\makebox[\headtextwidth][l]{\leftmark}}}}% % 左侧章/节标题
	% 奇数页 (右侧页眉)
	{\smash{\makebox[0pt][l]{\makebox[\headtotal][r]{%
		\makebox[\headtextwidth][r]{\hfill\rightmark}% % 右侧章/节标题
		\makebox[3\hscale]{}\rule[-1mm]{0.5pt}{19\vscale-1mm}\makebox[3\hscale]{}% % 垂直分隔线
		\makebox[7\hscale][l]{\thepage}}}}}% % 右侧页码 (左对齐)
	% 单面模式 (右侧页眉)
	{\smash{\makebox[0pt][l]{\makebox[\headtotal][r]{%
		\makebox[\headtextwidth][r]{\hfill\rightmark}%
		\makebox[3\hscale]{}\rule[-1mm]{0.5pt}{19\vscale-1mm}\makebox[3\hscale]{}%
		\makebox[7\hscale][l]{\thepage}}}}}%
}{%
	{}% % 偶数页页脚
	{}% % 奇数页页脚
	{}% % 单面模式页脚
}

% 重新定义 plain.scrheadings 样式（用于特殊页面，如章节开始）
% 页眉页脚均为空
\renewpagestyle{plain.scrheadings}{%
	{}%
	{}%
	{}%
}{%
	{}%
	{}%
	{}%
}

% 定义新的页眉样式 pagenum.scrheadings (页码在页脚)
\newpagestyle{pagenum.scrheadings}{%
	{}%
	{}%
	{}%
}{%
	{\makebox[\textwidth][r]{\thepage}}% % 偶数页页脚 (右对齐)
	{\makebox[\textwidth][l]{\thepage}}% % 奇数页页脚 (左对齐)
	{\makebox[\textwidth][l]{\thepage}}% % 单面模式页脚
}

% 定义新的页眉样式 centeredpagenum.scrheadings (页码在页脚居中)
\newpagestyle{centeredpagenum.scrheadings}{%
	{}%
	{}%
	{}%
}{%
	% 复杂的居中页码，考虑了页边距
	{\hspace{-\headmarginparwidth}\hspace{-\headmarginparsep}\makebox[\headtotal][l]{\hfill\thepage\hfill}}
	{\makebox[0pt][l]{\makebox[\headtotal][r]{\hfill\thepage\hfill}}}%
	{\makebox[0pt][l]{\makebox[\headtotal][r]{\hfill\thepage\hfill}}}%
