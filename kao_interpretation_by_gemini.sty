\ifxetexorluatex
	\newcommand{\kao@defaultfontmethod}{modern} % XeTeX 或 LuaTeX 默认使用 'modern' 字体方法
\else
	\newcommand{\kao@defaultfontmethod}{tex} % pdfTeX 默认使用 'tex' 字体方法
\fi

